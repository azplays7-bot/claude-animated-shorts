    "@remotion/renderer": "4.0.543",
    "@remotion/three": "4.0.543",
    "postprocessing": "6.37.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.543",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
