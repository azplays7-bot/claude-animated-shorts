 "chunks": [
  {
   "scene": 1,
   "start": 0.35,
   "end": 3.038,
   "text": "This EMPTY shop is about to change someone's LIFE."
  },
  {
   "scene": 1,
   "start": 3.388,
   "end": 4.121,
   "text": "Stay to the END"
  },
  {
   "scene": 1,
   "start": 4.121,
   "end": 5.415,
   "text": "to see what it BECOMES."
  },
  {
   "scene": 2,
   "start": 6.315,
   "end": 7.417,
   "text": "This is ROSA."
  },
  {
   "scene": 2,
   "start": 7.417,
   "end": 8.469,
   "text": "She works 9 to 5,"
  },
  {
   "scene": 2,
   "start": 8.819,
   "end": 9.913,
   "text": "and her hours make money"
  },
  {
   "scene": 2,
   "start": 9.913,
   "end": 10.889,
   "text": "for SOMEONE ELSE."
  },
  {
   "scene": 3,
   "start": 11.789,
   "end": 13.218,
   "text": "OWNING a business flips that."
  },
  {
   "scene": 3,
   "start": 13.568,
   "end": 14.894,
   "text": "Path one: a FRANCHISE."
  },
  {
   "scene": 3,
   "start": 14.894,
   "end": 17.088,
   "text": "You buy a proven BRAND and its PLAYBOOK,"
  },
  {
   "scene": 3,
   "start": 17.438,
   "end": 18.386,
   "text": "but you pay a FEE,"
  },
  {
   "scene": 3,
   "start": 18.386,
   "end": 21.513,
   "text": "plus ROYALTIES, often 4 to 8% of sales."
  },
  {
   "scene": 3,
   "start": 21.863,
   "end": 23.251,
   "text": "Path two: your OWN IDEA."
  },
  {
   "scene": 3,
   "start": 23.251,
   "end": 24.087,
   "text": "CHEAPER to start,"
  },
  {
   "scene": 3,
   "start": 24.087,
   "end": 25.276,
   "text": "but it's ALL on you."
  },
  {
   "scene": 4,
   "start": 26.176,
   "end": 28.154,
   "text": "Either way, the MATH is simple:"
  },
  {
   "scene": 4,
   "start": 28.154,
   "end": 30.251,
   "text": "SALES, minus COSTS, equals PROFIT."
  },
  {
   "scene": 4,
   "start": 30.601,
   "end": 31.311,
   "text": "Train a TEAM,"
  },
  {
   "scene": 4,
   "start": 31.311,
   "end": 33.331,
   "text": "and the shop EARNS even when you're away."
  },
  {
   "scene": 5,
   "start": 34.231,
   "end": 35.259,
   "text": "It's NOT easy."
  },
  {
   "scene": 5,
   "start": 35.259,
   "end": 38.178,
   "text": "About HALF of new businesses close within 5 years."
  },
  {
   "scene": 5,
   "start": 38.528,
   "end": 39.413,
   "text": "So start SMALL,"
  },
  {
   "scene": 5,
   "start": 39.413,
   "end": 40.284,
   "text": "TEST the idea,"
  },
  {
   "scene": 5,
   "start": 40.284,
   "end": 41.877,
   "text": "and READ every contract."
  },
  {
   "scene": 6,
   "start": 42.777,
   "end": 44.612,
   "text": "So what did that empty shop BECOME?"
  },
  {
   "scene": 6,
   "start": 45.562,
   "end": 46.693,
   "text": "ROSA'S BAKERY."
  },
  {
   "scene": 6,
   "start": 47.043,
   "end": 49.666,
   "text": "A year later, she hands her MANAGER the keys,"
  },
  {
   "scene": 6,
   "start": 49.666,
   "end": 51.203,
   "text": "and opens SHOP #2."
  },
  {
   "scene": 7,
   "start": 52.103,
   "end": 53.73,
   "text": "Your first step is FREE:"
  },
  {
   "scene": 7,
   "start": 53.73,
   "end": 56.177,
   "text": "write down 3 PROBLEMS people pay to fix."
  }
 ]
