 "chunks": [
  {
   "scene": 1,
   "start": 0.8,
   "end": 1.55,
   "text": "At TWELVE,"
  },
  {
   "scene": 1,
   "start": 1.55,
   "end": 3.552,
   "text": "this boy LEFT his family behind."
  },
  {
   "scene": 1,
   "start": 3.752,
   "end": 4.936,
   "text": "He was POOR, HOMESICK,"
  },
  {
   "scene": 1,
   "start": 4.936,
   "end": 6.888,
   "text": "and LAUGHED AT for the way he spoke."
  },
  {
   "scene": 1,
   "start": 7.088,
   "end": 9.733,
   "text": "But one day, the WHOLE WORLD would know his name."
  },
  {
   "scene": 2,
   "start": 10.083,
   "end": 12.424,
   "text": "He grew up on a small PORTUGUESE ISLAND,"
  },
  {
   "scene": 2,
   "start": 12.424,
   "end": 14.841,
   "text": "in a family that STRUGGLED financially."
  },
  {
   "scene": 2,
   "start": 15.041,
   "end": 17.598,
   "text": "His FATHER worked at a local football club,"
  },
  {
   "scene": 2,
   "start": 17.598,
   "end": 19.691,
   "text": "where the boy fell in LOVE with the game."
  },
  {
   "scene": 3,
   "start": 20.041,
   "end": 22.651,
   "text": "At TWELVE, he moved HUNDREDS OF MILES away"
  },
  {
   "scene": 3,
   "start": 22.651,
   "end": 24.244,
   "text": "to join a football ACADEMY."
  },
  {
   "scene": 3,
   "start": 24.444,
   "end": 26.279,
   "text": "He MISSED his family terribly."
  },
  {
   "scene": 3,
   "start": 26.479,
   "end": 28.804,
   "text": "Classmates MOCKED his island accent."
  },
  {
   "scene": 3,
   "start": 29.004,
   "end": 30.711,
   "text": "But he REFUSED to give up."
  },
  {
   "scene": 4,
   "start": 31.061,
   "end": 32.917,
   "text": "Then came another OBSTACLE."
  },
  {
   "scene": 4,
   "start": 33.117,
   "end": 36.423,
   "text": "As a teenager, doctors discovered a HEART CONDITION."
  },
  {
   "scene": 4,
   "start": 36.623,
   "end": 38.41,
   "text": "After treatment, he RECOVERED"
  },
  {
   "scene": 4,
   "start": 38.41,
   "end": 39.781,
   "text": "and RETURNED to football."
  },
  {
   "scene": 4,
   "start": 39.981,
   "end": 41.709,
   "text": "His dream was STILL ALIVE."
  },
  {
   "scene": 5,
   "start": 42.059,
   "end": 43.348,
   "text": "That same boy would win"
  },
  {
   "scene": 5,
   "start": 43.348,
   "end": 45.099,
   "text": "FIVE BALLON D'OR AWARDS,"
  },
  {
   "scene": 5,
   "start": 45.099,
   "end": 46.987,
   "text": "FIVE CHAMPIONS LEAGUE titles,"
  },
  {
   "scene": 5,
   "start": 47.187,
   "end": 49.621,
   "text": "and become one of the GREATEST GOALSCORERS"
  },
  {
   "scene": 5,
   "start": 49.621,
   "end": 50.856,
   "text": "football has ever seen."
  },
  {
   "scene": 5,
   "start": 51.056,
   "end": 52.407,
   "text": "From a SMALL ISLAND,"
  },
  {
   "scene": 5,
   "start": 52.407,
   "end": 54.235,
   "text": "to the BIGGEST STADIUMS on Earth."
  },
  {
   "scene": 6,
   "start": 54.6,
   "end": 57.032,
   "text": "That little boy was CRISTIANO RONALDO."
  },
  {
   "scene": 6,
   "start": 57.232,
   "end": 59.557,
   "text": "Never let your BEGINNING decide your ENDING."
  }
 ]
}